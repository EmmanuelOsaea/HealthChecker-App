<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    android:background="#F5F5F5">

    <ImageView
    android:layout_width="120dp"
    android:layout_height="120dp"
    android:scaleType="centerCrop"
    android:contentDescription="App Logo"
    android:src="   " />
  
    
    
    
    
    
  <Button
        android:id="@+id/btnCheckHealth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Check My Health"
        android:backgroundTint="#2196F3"
        android:textColor="#FFFFFF"
        android:padding="12dp" />

    <LinearLayout
        android:id="@+id/resultContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/result_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your result will appear here"
            android:textSize="18sp"
            android:textColor="#000000" />
    </LinearLayout>

    <Button
        android:id="@+id/btnViewTips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Health Tip"
        android:layout_marginTop="20dp"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/tvTips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Tap to get a health tip"
        android:textColor="#555555"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnViewHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View History"
        android:layout_marginTop="24dp"
        android:backgroundTint="#FF9800"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnStartMonitoring"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Monitoring"/>
        
    <Button
        android:id="@+id/btnStopMonitoring"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stop Monitoring"
        android:layout_marginTop="16dp"/>
</LinearLayout>

<com.github.mikephil.charting.charts.LineChart
    android:id="@+id/bmiChart"
    android:layout_width="match_parent"
    android:layout_height="250dp"
    android:layout_marginTop="16dp" />
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/health_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Checking health..."
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
